# Copiar como .env y ajustar. El archivo .env NO se sube al repo.
POSTGRES_USER=reactor
POSTGRES_PASSWORD=reactor_dev
POSTGRES_DB=reactor
DATABASE_URL=postgresql+psycopg://reactor:reactor_dev@db:5432/reactor

APP_ENV=development
# Orígenes web que pueden llamar a la API (cliente móvil). * solo en desarrollo.
CORS_ORIGENES=*
JWT_SECRET=cambiar-esto-en-produccion

# Se completan más adelante (US-02 y US-04)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
