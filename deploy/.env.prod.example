# Plantilla del .env de PRODUCCIÓN. En la VM: cp deploy/.env.prod.example .env y llenar.
# El .env real nunca se sube al repo. Generar claves con: openssl rand -hex 32

# Dominio de la IP pública de la VM (etiqueta DNS en Azure)
DOMINIO=control-reactor.northcentralus.cloudapp.azure.com

POSTGRES_USER=reactor
POSTGRES_PASSWORD=CAMBIAR_clave_larga
POSTGRES_DB=reactor
# Misma clave que POSTGRES_PASSWORD; el host es el servicio "db" del compose
DATABASE_URL=postgresql+psycopg://reactor:CAMBIAR_clave_larga@db:5432/reactor

APP_ENV=production
# Solo la página servida por Caddy puede llamar a la API desde el navegador
CORS_ORIGENES=https://control-reactor.northcentralus.cloudapp.azure.com
# Mínimo 32 caracteres, distinta a la de desarrollo
JWT_SECRET=CAMBIAR_openssl_rand_hex_32
# Con /api: así quedan bien los enlaces de los correos y el callback de Google
URL_PUBLICA=https://control-reactor.northcentralus.cloudapp.azure.com/api

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
